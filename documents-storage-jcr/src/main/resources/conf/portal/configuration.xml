<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_3.xsd http://www.exoplatform.org/xml/ns/kernel_1_3.xsd"
  xmlns="http://www.exoplatform.org/xml/ns/kernel_1_3.xsd">

  <component>
    <key>org.exoplatform.documents.storage.DocumentFileStorage</key>
    <type>org.exoplatform.documents.storage.jcr.JCRDocumentFileStorage</type>
  </component>

  <component>
    <key>org.exoplatform.documents.storage.JCRDeleteFileStorage</key>
    <type>org.exoplatform.documents.storage.jcr.JCRDeleteFileStorageImpl</type>
  </component>


  <component>
    <type>org.exoplatform.documents.storage.jcr.bulkactions.BulkStorageActionService</type>
  </component>

  <component>
    <key>org.exoplatform.documents.storage.TrashStorage</key>
    <type>org.exoplatform.documents.storage.jcr.TrashStorageImpl</type>
    <init-params>
      <value-param>
        <name>trashWorkspace</name>
        <value>collaboration</value>
      </value-param>
      <value-param>
        <name>trashHomeNodePath</name>
        <value>/Trash</value>
      </value-param>
    </init-params>
  </component>

  <component>
    <key>org.exoplatform.documents.storage.RecycleBinStorage</key>
    <type>org.exoplatform.documents.storage.jcr.JCRRecycleBinStorage</type>
  </component>

  <component>
    <key>org.exoplatform.documents.storage.jcr.search.DocumentSearchServiceConnector</key>
    <type>org.exoplatform.documents.storage.jcr.search.DocumentSearchServiceConnector</type>
    <init-params>
      <value-param>
        <name>query.file.path</name>
        <value>${exo.documents.es.query.path:jar:/documents-search-query.json}</value>
      </value-param>
      <properties-param>
        <name>constructor.params</name>
        <property name="searchType" value="files" />
        <property name="index" value="file_alias" />
      </properties-param>
    </init-params>
  </component>

  <external-component-plugins>
    <target-component>org.exoplatform.services.listener.ListenerService</target-component>
    <component-plugin>
      <name>hide_folder_event</name>
      <set-method>addListener</set-method>
      <type>org.exoplatform.documents.storage.jcr.listener.HideFolderListener</type>
    </component-plugin>
  </external-component-plugins>

  <external-component-plugins>
    <target-component>org.exoplatform.services.jcr.RepositoryService</target-component>
    <component-plugin>
      <name>add.documents.nodeTypes</name>
      <set-method>addPlugin</set-method>
      <type>org.exoplatform.services.jcr.impl.AddNodeTypePlugin</type>
      <init-params>
        <values-param>
          <name>autoCreatedInNewRepository</name>
          <description>Documents node types</description>
          <value>jar:/conf/documents-nodetypes.xml</value>
        </values-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

  <external-component-plugins>
    <target-component>org.exoplatform.commons.upgrade.UpgradeProductService</target-component>
    <component-plugin>
      <name>RecycleBinItemsUpgradePlugin</name>
      <set-method>addUpgradePlugin</set-method>
      <type>org.exoplatform.documents.storage.jcr.upgrade.RecycleBinItemsUpgradePlugin</type>
      <description>Gives the documents already in the trash the facts the Recycle Bin lists them with</description>
      <init-params>
        <value-param>
          <name>product.group.id</name>
          <description>The groupId of the product</description>
          <value>org.exoplatform.social</value>
        </value-param>
        <value-param>
          <name>plugin.execution.order</name>
          <description>The plugin execution order</description>
          <value>1</value>
        </value-param>
        <value-param>
          <name>plugin.upgrade.execute.once</name>
          <description>Execute only once, not each version change</description>
          <value>true</value>
        </value-param>
        <value-param>
          <name>plugin.upgrade.async.execution</name>
          <description>Execute this upgrade asynchronously, without holding the startup</description>
          <value>true</value>
        </value-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

</configuration>
