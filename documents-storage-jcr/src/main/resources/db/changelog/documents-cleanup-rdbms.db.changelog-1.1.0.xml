<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <!-- Managing both DB that use sequences and db that use auto increment -->
    <property name="autoIncrement" value="true" dbms="mysql,mssql,h2,sybase,db2,hsqldb"/>
    <property name="autoIncrement" value="false" dbms="oracle,postgresql"/>

    <changeSet author="documents" id="documents-cleanup-1.1.0-0">
        <createTable tableName="DOCUMENTS_CLEANUP_CAMPAIGN">
            <column name="ID" type="BIGINT" autoIncrement="${autoIncrement}" startWith="1">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_DOCUMENTS_CLEANUP_CAMPAIGN"/>
            </column>
            <column name="NAME" type="NVARCHAR(250)">
                <constraints nullable="false"/>
            </column>
            <column name="STATE" type="NVARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="PERIOD_MONTHS" type="INT"/>
            <column name="MIN_FILE_SIZE_BYTES" type="BIGINT"/>
            <column name="GRACE_DAYS" type="INT"/>
            <column name="MAX_VERSIONS_PER_FILE" type="INT"/>
            <column name="EXCLUDED_PATHS" type="NVARCHAR(4000)"/>
            <column name="STARTED_DATE" type="TIMESTAMP"/>
            <column name="PUBLISHED_DATE" type="TIMESTAMP"/>
            <column name="LOCK_DATE" type="TIMESTAMP"/>
            <column name="COMPLETED_DATE" type="TIMESTAMP"/>
            <column name="TOTAL_COUNT" type="BIGINT"/>
            <column name="PROCESSED_COUNT" type="BIGINT"/>
            <column name="ETA_SECONDS" type="BIGINT"/>
            <column name="CHECKPOINT_OFFSET" type="BIGINT"/>
            <column name="CHECKPOINT_PATH" type="NVARCHAR(2000)"/>
            <column name="SUMMARY_JSON" type="NVARCHAR(4000)"/>
            <column name="ARCHIVE_FILE_ID" type="BIGINT"/>
        </createTable>
        <modifySql dbms="mysql">
            <append value=" ENGINE=INNODB CHARSET=UTF8 COLLATE utf8_general_ci"/>
        </modifySql>
    </changeSet>

    <changeSet author="documents" id="documents-cleanup-1.1.0-1" dbms="hsqldb,oracle,postgresql">
        <createSequence sequenceName="SEQ_DOCUMENTS_CLEANUP_CAMPAIGN_ID" startValue="1"/>
    </changeSet>

    <changeSet author="documents" id="documents-cleanup-1.1.0-2">
        <createTable tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM">
            <column name="ID" type="BIGINT" autoIncrement="${autoIncrement}" startWith="1">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_DOCUMENTS_CLEANUP_ITEM"/>
            </column>
            <column name="CAMPAIGN_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="NODE_UUID" type="NVARCHAR(250)">
                <constraints nullable="false"/>
            </column>
            <column name="PATH" type="NVARCHAR(2000)"/>
            <column name="OWNER_IDENTITY_ID" type="BIGINT"/>
            <column name="FILE_SIZE" type="BIGINT"/>
            <column name="VERSIONS_SIZE" type="BIGINT"/>
            <column name="ACTION" type="NVARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="STATE" type="NVARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="COMPUTED_AT" type="TIMESTAMP"/>
            <column name="DECIDED_BY" type="NVARCHAR(250)"/>
            <column name="DECIDED_AT" type="TIMESTAMP"/>
            <column name="PURGED_AT" type="TIMESTAMP"/>
            <column name="RECLAIMED_BYTES" type="BIGINT"/>
            <column name="FAILURE_REASON" type="NVARCHAR(2000)"/>
        </createTable>
        <modifySql dbms="mysql">
            <append value=" ENGINE=INNODB CHARSET=UTF8 COLLATE utf8_general_ci"/>
        </modifySql>
    </changeSet>

    <changeSet author="documents" id="documents-cleanup-1.1.0-3" dbms="hsqldb,oracle,postgresql">
        <createSequence sequenceName="SEQ_DOCUMENTS_CLEANUP_CAMPAIGN_ITEM_ID" startValue="1"/>
    </changeSet>

    <changeSet author="documents" id="documents-cleanup-1.1.0-4">
        <createIndex tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM" indexName="IDX_DOC_CLEANUP_ITEM_CAMPAIGN">
            <column name="CAMPAIGN_ID"/>
        </createIndex>
        <createIndex tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM" indexName="IDX_DOC_CLEANUP_ITEM_OWNER">
            <column name="CAMPAIGN_ID"/>
            <column name="OWNER_IDENTITY_ID"/>
        </createIndex>
        <createIndex tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM" indexName="IDX_DOC_CLEANUP_ITEM_STATE">
            <column name="CAMPAIGN_ID"/>
            <column name="STATE"/>
        </createIndex>
    </changeSet>

    <changeSet author="documents" id="documents-cleanup-1.1.0-5">
        <addUniqueConstraint tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM"
                             columnNames="CAMPAIGN_ID, NODE_UUID"
                             constraintName="UK_DOC_CLEANUP_ITEM_NODE"/>
    </changeSet>

    <!-- Candidacy dates of the scanned file: both are NULLABLE and added, never
         backfilled, so the rows of a campaign already scanned keep a NULL and a
         dry-run running while this changeset applies is left untouched -->
    <changeSet author="documents" id="documents-cleanup-1.1.0-6">
        <addColumn tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM">
            <column name="LAST_MODIFIED_DATE" type="TIMESTAMP"/>
            <column name="CREATED_DATE" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

    <!-- Failure DIAGNOSTIC of an item, split from its localizable FAILURE_REASON
         message code: a CLOB, because a JCR stack trace with an embedded SQL
         error does not fit a bounded column. ATTEMPT_COUNT carries the retry
         attempts already spent on the item. Both are NULLABLE and added, never
         backfilled — the rows of a campaign already executed keep a NULL detail
         and a 0 attempt count, and a purge running while this changeset applies
         is left untouched -->
    <changeSet author="documents" id="documents-cleanup-1.1.0-7">
        <addColumn tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM">
            <column name="FAILURE_DETAIL" type="CLOB"/>
            <column name="ATTEMPT_COUNT" type="BIGINT" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>

    <!-- Partitions of the parallel dry-run scan: one row per subtree walked by one
         reader thread, carrying its OWN state, path checkpoint and counters. A new
         table, so strictly additive: a campaign scanned by the sequential worker
         simply has no unit row, and gets re-planned into units on its next resume -->
    <changeSet author="documents" id="documents-cleanup-1.1.0-8">
        <createTable tableName="DOCUMENTS_CLEANUP_CAMPAIGN_SCAN_UNIT">
            <column name="ID" type="BIGINT" autoIncrement="${autoIncrement}" startWith="1">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_DOCUMENTS_CLEANUP_SCAN_UNIT"/>
            </column>
            <column name="CAMPAIGN_ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="UNIT_PATH" type="NVARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <!-- SHA-256 hex of UNIT_PATH, carried ONLY to be the unique key: a unique
                 constraint on UNIT_PATH itself cannot be created on MySQL, where the
                 table's own CHARSET=UTF8 makes 8 + 2000*3 = 6008 bytes against InnoDB's
                 3072-byte ceiling, so Liquibase halts and the addon does not deploy.
                 Same reason changeset -5 keyed the item table on the short NODE_UUID and
                 not on its adjacent PATH NVARCHAR(2000) -->
            <column name="UNIT_PATH_HASH" type="NVARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="STATE" type="NVARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="LAST_SCANNED_PATH" type="NVARCHAR(2000)"/>
            <column name="SCANNED_COUNT" type="BIGINT" defaultValueNumeric="0"/>
            <!-- NULLABLE and WITHOUT a default, deliberately: NULL means 'never
                 counted' and 0 means 'counted, and legitimately empty'. A default of 0
                 made the two indistinguishable, so a genuinely empty bucket was
                 re-counted by the estimation phase of every single resume -->
            <column name="TOTAL_COUNT" type="BIGINT"/>
            <!-- Walk attempts already spent on this unit, incremented when the
                 coordinator claims it. It is what BOUNDS the retry of a failed unit: a
                 subtree that failed MAX_SCAN_UNIT_ATTEMPTS walks is settled-failed and
                 stops holding the whole dry-run back -->
            <!-- NOT NULL on purpose: the work-list query reads
                 NOT (STATE = FAILED AND ATTEMPT_COUNT >= :max), and SQL three-valued logic
                 turns that into UNKNOWN for a NULL — silently dropping a FAILED unit from
                 the work list, so its subtree would never be walked again AND never settle,
                 holding completion open for good. The entity writes a primitive long, so a
                 NULL is unreachable today; the constraint is what keeps it unreachable -->
            <column name="ATTEMPT_COUNT" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="FAILURE_REASON" type="NVARCHAR(2000)"/>
        </createTable>
        <modifySql dbms="mysql">
            <append value=" ENGINE=INNODB CHARSET=UTF8 COLLATE utf8_general_ci"/>
        </modifySql>
    </changeSet>

    <changeSet author="documents" id="documents-cleanup-1.1.0-9" dbms="hsqldb,oracle,postgresql">
        <createSequence sequenceName="SEQ_DOCUMENTS_CLEANUP_SCAN_UNIT_ID" startValue="1"/>
    </changeSet>

    <!-- The unique constraint is what makes unit planning IDEMPOTENT when a scan
         resumes, exactly as UK_DOC_CLEANUP_ITEM_NODE makes candidate saving
         idempotent: a re-plan can never duplicate a unit nor reset the checkpoint
         of a subtree already walked -->
    <changeSet author="documents" id="documents-cleanup-1.1.0-10">
        <createIndex tableName="DOCUMENTS_CLEANUP_CAMPAIGN_SCAN_UNIT" indexName="IDX_DOC_CLEANUP_SCAN_UNIT_STATE">
            <column name="CAMPAIGN_ID"/>
            <column name="STATE"/>
        </createIndex>
        <addUniqueConstraint tableName="DOCUMENTS_CLEANUP_CAMPAIGN_SCAN_UNIT"
                             columnNames="CAMPAIGN_ID, UNIT_PATH_HASH"
                             constraintName="UK_DOC_CLEANUP_SCAN_UNIT_PATH"/>
    </changeSet>

    <!-- FILE_SIZE and VERSIONS_SIZE feed ARITHMETIC, not just a display: the
         reclaimable figure of a row is FILE_SIZE + VERSIONS_SIZE for a DELETE
         (see CleanupCampaignItemDAO#RECLAIMABLE_BYTES), and under SQL
         three-valued logic NULL + n is NULL while SUM SKIPS a NULL — so one such
         row would drop out of sumReclaimableBytesByState, of the campaigns-list
         aggregates and of both comparison queries ENTIRELY, under-reporting the
         campaign by that whole row instead of by its versions alone, and
         silently. COALESCE(SUM(...), 0) does not cover it: it guards an EMPTY
         result, not a NULL addend. The aggregates are the ONE path reading these
         columns without materializing the entity — which maps both as a
         primitive long, so a NULL is unreachable from the application today; the
         constraint is what keeps it unreachable. Same defect class, and same fix,
         as ATTEMPT_COUNT in changeset -8. Existing NULLs (there are none from the
         application, but a row hand-fixed by a DBA is not impossible) are set to
         0 as part of the constraint change, and the zero DEFAULT is (re)declared
         AFTER it: on MySQL the NOT NULL modification rewrites the column
         definition and would drop a default declared before it. No index or key
         is added — both columns are BIGINT, but the MySQL row-size lesson of
         changesets -5/-8 is that a key belongs on the narrow column only -->
    <changeSet author="documents" id="documents-cleanup-1.1.0-11">
        <addNotNullConstraint tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM"
                              columnName="FILE_SIZE"
                              columnDataType="BIGINT"
                              defaultNullValue="0"/>
        <addNotNullConstraint tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM"
                              columnName="VERSIONS_SIZE"
                              columnDataType="BIGINT"
                              defaultNullValue="0"/>
        <addDefaultValue tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM"
                         columnName="FILE_SIZE"
                         columnDataType="BIGINT"
                         defaultValueNumeric="0"/>
        <addDefaultValue tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM"
                         columnName="VERSIONS_SIZE"
                         columnDataType="BIGINT"
                         defaultValueNumeric="0"/>
    </changeSet>

    <!-- Per-node evaluation failures of a scan unit. A node whose candidacy could
         not be evaluated (a NullPointerException on a mix:versionable node with no
         base version, a transient repository error) was logged as a WARN, skipped,
         and the unit still finished DONE — so the file vanished from the report
         while the campaign claimed a complete scan. These three columns are what
         make that visible: how many nodes THIS subtree lost, and the first failure
         with its stack trace so the cause is diagnosable without the server log.
         Strictly additive, and the count defaults to 0 so every unit written before
         them reads "nothing lost" rather than "unknown" -->
    <changeSet author="documents" id="documents-cleanup-1.1.0-12">
        <addColumn tableName="DOCUMENTS_CLEANUP_CAMPAIGN_SCAN_UNIT">
            <column name="EVAL_FAILURE_COUNT" type="BIGINT" defaultValueNumeric="0"/>
            <column name="EVAL_FAILURE_REASON" type="NVARCHAR(255)"/>
            <column name="EVAL_FAILURE_DETAIL" type="CLOB"/>
        </addColumn>
    </changeSet>

    <!-- Reader threads of a campaign's dry-run scan, chosen per campaign. The right
         fan-out depends on the corpus being walked and on what else the repository
         is serving at that moment, neither of which a deployment property can know,
         and an administrator tuning a run should not need a restart to try another
         value. Strictly additive with a 0 default, and 0 means 'never set': every
         campaign written before this column keeps running on the platform default,
         which is exactly what it ran with -->
    <changeSet author="documents" id="documents-cleanup-1.1.0-13">
        <addColumn tableName="DOCUMENTS_CLEANUP_CAMPAIGN">
            <column name="SCAN_THREADS" type="INT" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>

    <!-- The reclaimable figure, DENORMALIZED into a column and indexed. It was a JPQL
         CASE expression, which no index can serve: the purge consumes its candidates
         biggest first, so ordering on it made every batch a filesort over the
         campaign's remaining rows — measured at 318 ms against 4 ms per batch on
         200k rows, tens of thousands of batches per run, cost growing with the
         square of the item count. That is the very shape keyset paging replaced
         offset paging to avoid, reintroduced through the ORDER BY.

         Three steps, in this order and all reversible: add the column with a 0
         default, BACKFILL it from the columns it derives from (without which every
         pre-existing campaign would sort and sum as zero), then swap the
         (CAMPAIGN_ID, STATE) index for one that also carries the figure and the id.
         The new index is a strict superset by leftmost prefix, so every query the
         dropped one served is still served — one wider index instead of two, which
         keeps the candidate-insert cost of a scan where it was.

         No second source of truth: the definition stays in CleanupSizeUtil, applied
         by CleanupCampaignStorage#toEntity on EVERY save, and this column becomes the
         one thing the SQL and the in-memory comparator both read -->
    <changeSet author="documents" id="documents-cleanup-1.1.0-14">
        <addColumn tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM">
            <column name="RECLAIMABLE_BYTES" type="BIGINT" defaultValueNumeric="0"/>
        </addColumn>
        <update tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM">
            <column name="RECLAIMABLE_BYTES"
                    valueComputed="CASE WHEN ACTION = 'DELETE' THEN FILE_SIZE + VERSIONS_SIZE ELSE VERSIONS_SIZE END"/>
        </update>
        <dropIndex tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM" indexName="IDX_DOC_CLEANUP_ITEM_STATE"/>
        <createIndex tableName="DOCUMENTS_CLEANUP_CAMPAIGN_ITEM" indexName="IDX_DOC_CLEANUP_ITEM_RECLAIMABLE">
            <column name="CAMPAIGN_ID"/>
            <column name="STATE"/>
            <column name="RECLAIMABLE_BYTES"/>
            <column name="ID"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
