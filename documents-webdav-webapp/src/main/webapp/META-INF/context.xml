<Context path="/webdav" docBase="webdav" reloadable="true" crossContext="false">
  <Valve className="org.exoplatform.documents.webdav.valve.WebdavLoggingValve" />
  <Valve className="io.meeds.web.security.authenticator.DigestAuthenticatorValve" />
  <Realm
    className='org.apache.catalina.realm.JAASRealm'
    appName='webdav-domain'
    configFile="/webdav-jaas.conf"
    userClassNames="org.exoplatform.services.security.jaas.UserPrincipal"
    roleClassNames="org.exoplatform.services.security.jaas.RolePrincipal" />
</Context>
