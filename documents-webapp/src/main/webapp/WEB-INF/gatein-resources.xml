  <!-- AttachmentsPortlet skins -->
  <!-- Reuse the Documents app skin so the reused documents-list-view / cells
       render exactly like the Documents app (declared before attachmentsApp.css
       so drawer-specific overrides in attachmentsApp.css win style ties). -->
