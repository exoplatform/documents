<?xml version="1.0" encoding="UTF-8"?>
<portlet-app xmlns="http://java.sun.com/xml/ns/portlet/portlet-app_2_0.xsd"
             version="2.0"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/portlet/portlet-app_2_0.xsd http://java.sun.com/xml/ns/portlet/portlet-app_2_0.xsd">

  <portlet>
    <portlet-name>Documents</portlet-name>
    <display-name xml:lang="EN">Documents Application</display-name>
    <portlet-class>org.exoplatform.documents.portlet.DocumentPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/WEB-INF/jsp/document.jsp</value>
    </init-param>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <supported-locale>en</supported-locale>
    <resource-bundle>locale.portlet.Documents</resource-bundle>
    <portlet-info>
      <title>Documents Application</title>
      <keywords>Documents Application</keywords>
    </portlet-info>
    <portlet-preferences>
      <preference>
        <name>settings</name>
        <value>
          {
          "enabledViewList":[],
          "defaultView":"timeline",
          "expendedTreeView":true,
          "allowFilteringPerCategory":true,
          "categoryDepth":4,
          "categoryIds": [],
          }
        </value>
      </preference>
    </portlet-preferences>
  </portlet>

  <portlet>
    <portlet-name>DownloadDocumentsPublicAccess</portlet-name>
    <display-name xml:lang="EN">Download Documents Public Access</display-name>
    <portlet-class>org.exoplatform.commons.api.portlet.GenericDispatchedViewPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/WEB-INF/jsp/download_document.jsp</value>
    </init-param>
    <expiration-cache>0</expiration-cache>
    <cache-scope>PUBLIC</cache-scope>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <supported-locale>en</supported-locale>
    <resource-bundle>locale.portlet.Documents</resource-bundle>
    <portlet-info>
      <title>Download Documents Public Access</title>
      <keywords>Download Documents Public Access</keywords>
    </portlet-info>
  </portlet>

  <portlet>
    <portlet-name>DocumentsSizeGadget</portlet-name>
    <display-name>Documents Size Gadget</display-name>
    <portlet-class>org.exoplatform.commons.api.portlet.GenericDispatchedViewPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/html/documentsSizeGadget.html</value>
    </init-param>
    <expiration-cache>-1</expiration-cache>
    <cache-scope>PUBLIC</cache-scope>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <supported-locale>en</supported-locale>
    <portlet-info>
      <title>Documents Size Gadget</title>
      <keywords>Documents Size Gadget</keywords>
    </portlet-info>
  </portlet>

  <portlet>
    <portlet-name>TrashManagement</portlet-name>
    <display-name>Trash Management</display-name>
    <portlet-class>org.exoplatform.commons.api.portlet.GenericDispatchedViewPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/html/trashManagement.html</value>
    </init-param>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <supported-locale>en</supported-locale>
    <resource-bundle>locale.portlet.TrashManagement</resource-bundle>
    <portlet-info>
      <title>Trash Management</title>
      <keywords>Trash Management</keywords>
    </portlet-info>
  </portlet>

  <portlet>
    <portlet-name>DocumentCleanupAdmin</portlet-name>
    <display-name>Document Cleanup Campaigns Administration</display-name>
    <portlet-class>org.exoplatform.commons.api.portlet.GenericDispatchedViewPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/html/documentCleanupAdmin.html</value>
    </init-param>
    <expiration-cache>-1</expiration-cache>
    <cache-scope>PUBLIC</cache-scope>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <supported-locale>en</supported-locale>
    <resource-bundle>locale.portlet.DocumentCleanupAdmin</resource-bundle>
    <portlet-info>
      <title>Document Cleanup Campaigns Administration</title>
      <keywords>Document Cleanup Campaigns Administration</keywords>
    </portlet-info>
  </portlet>

  <portlet>
    <portlet-name>DocumentsUserSettings</portlet-name>
    <display-name>Documents User Settings</display-name>
    <portlet-class>org.exoplatform.commons.api.portlet.GenericDispatchedViewPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/html/documentsUserSettings.html</value>
    </init-param>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <supported-locale>en</supported-locale>
    <resource-bundle>locale.portlet.social.UserSettings</resource-bundle>
    <portlet-info>
      <title>Documents User Settings</title>
      <keywords>Documents User Settings</keywords>
    </portlet-info>
  </portlet>

  <portlet>
    <portlet-name>AttachmentApp</portlet-name>
    <portlet-class>org.exoplatform.commons.api.portlet.GenericDispatchedViewPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/html/attachment.html</value>
    </init-param>
    <init-param>
      <name>preload.resource.bundles</name>
      <value>locale.portlet.attachments</value>
    </init-param>
    <init-param>
      <name>layout-css-class</name>
      <value>no-layout-style</value>
    </init-param>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <supported-locale>en</supported-locale>
    <resource-bundle>locale.portlet.attachments</resource-bundle>
    <portlet-info>
      <title>Attachments Application</title>
    </portlet-info>
    <portlet-preferences>
      <preference>
        <name>jsModule</name>
        <value>PORTLET/documents/attachmentApp</value>
      </preference>
    </portlet-preferences>
  </portlet>

  <portlet>
    <portlet-name>RestrictedDrive</portlet-name>
    <display-name>Restricted Drive</display-name>
    <portlet-class>org.exoplatform.commons.api.portlet.GenericDispatchedViewPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/WEB-INF/jsp/restrictedDrive.jsp</value>
    </init-param>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <supported-locale>en</supported-locale>
    <resource-bundle>locale.portlet.RestrictedDrive</resource-bundle>
    <portlet-info>
      <title>Restricted Drive</title>
      <keywords>Restricted Drive</keywords>
    </portlet-info>
  </portlet>

  <portlet>
    <portlet-name>DocumentGadget</portlet-name>
    <display-name>Document Gadget</display-name>
    <portlet-class>org.exoplatform.documents.portlet.DocumentGadgetPortlet</portlet-class>
    <init-param>
      <name>portlet-view-dispatched-file-path</name>
      <value>/WEB-INF/jsp/documentGadget.jsp</value>
    </init-param>
    <init-param>
      <name>preload.resource.bundles</name>
      <value>locale.portlet.Documents</value>
    </init-param>
    <init-param>
      <name>layout-content-editable</name>
      <value>true</value>
    </init-param>
    <supports>
      <mime-type>text/html</mime-type>
    </supports>
    <portlet-info>
      <title>Document Gadget</title>
    </portlet-info>
  </portlet>
</portlet-app>
